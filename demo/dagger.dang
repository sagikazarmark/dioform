type Demo {
  let node: Container!
  let dioxus: Dioxus!
  let workerBuild: WorkerBuild!

  new(ws: Workspace!, rustVersion: String!, nodeVersion: String! = "latest") {
    # clang is needed to cross-compile the C sysroot pulled in
    # by the `dioxus-code` snippet highlighter (arborium/tree-sitter) for the wasm32 target.
    # The `cc` crate auto-selects clang for wasm32-unknown-unknown, so installing it is enough.
    let rustContainer = Dagger
      .container
      .from("rust:" + rustVersion)
      .withMountedCache("/var/cache/apt/archives", Dagger.cacheVolume("debian-apt-archives"))
      .withEnvVariable("DEBIAN_FRONTEND", "noninteractive")
      .withExec(["apt-get", "update"])
      .withExec(["apt-get", "install", "-y", "--no-install-recommends", "clang"])

    let node = Dagger
      .container
      .from("node:" + nodeVersion)
      .withEnvVariable("NPM_CONFIG_CACHE", "/root/.npm")
      .withMountedCache("${NPM_CONFIG_CACHE}", Dagger.cacheVolume("npm"), expand: true)
      .withMountedDirectory("/work/src", ws.directory("", gitignore: true))
      .withWorkdir("/work/src")
      .withExec(["npm", "install"])

    let assets = node
      .withExec(["npm", "run", "build"])
      .directory("assets")
      .filter(include: ["style.css"])

    ws = ws.withDirectory("assets", assets)

    self.node = node
    self.dioxus = Dagger.dioxus(ws: ws, container: rustContainer)
    self.workerBuild = Dagger.workerBuild(ws: ws, container: rustContainer)

    self
  }

  """
  Build the demo application.
  """
  build: Directory! @check {
    self
      .dioxus
      .bundle(
        fullstack: true,
        release: true,
        debugSymbols: false,
        clientArgs: ["--features", "fullstack-web"],
      )
  }

  """
  Run the demo application.
  """
  service: Service! @up {
    self.dioxus.serve(
      fullstack: true,
      clientArgs: ["--features", "fullstack-web"],
    )
  }

  """
  Run end-to-end tests.
  """
  test: Directory! @check {
    self
      .playwright(self.testService)
      .withExec(["npm", "exec", "--", "playwright", "test", "--config", "playwright.config.ts"])
      .directory("build/playwright")
  }

  """
  Reinstall the daisyUI components vendored under `src/components/daisyui`.

  `dx components add` copies component source into the project instead of adding
  a crate, so the copies go stale as the registry moves without anything here
  failing to build. As a generator this pulls them forward; as a check it fails
  when what is committed is not what the registry produces.
  """
  components(ws: Workspace!): Changeset! @generate {
    let modulePath = "src/components/daisyui"
    let registryPath = "/opt/dioxus-daisyui-components"
    let source = ws.directory("", gitignore: true)

    # The committed copies are the list to reinstall: `dx` records nothing about
    # what it installed, and a second list would only drift from this one.
    let components = source
      .directory(modulePath)
      .entries
      .filter { _.hasSuffix("/") }
      .map { _.trimSuffix("/") }

    let regenerated = self
      .dioxus
      .container
      .withMountedDirectory(
        registryPath,
        Dagger.git("https://github.com/sagikazarmark/dioxus-daisyui-components").head.tree,
      )
      # Cleared first so a file the registry no longer ships does not survive as
      # a copy `dx` never overwrites.
      .withExec(["rm", "-rf", modulePath])
      .withExec(["dx", "components", "add", "--force", "--path", registryPath, "--module-path", modulePath] + components)
      # `dx` writes the module file's component list in an arbitrary order, so
      # the copies only settle once rustfmt, which sorts it, has been over them.
      # It is not part of the build toolchain, hence the install.
      .withExec(["rustup", "component", "add", "rustfmt"])
      .withExec(["cargo", "fmt"])
      .directory(modulePath)

    source.withoutDirectory(modulePath).withDirectory(modulePath, regenerated).changes(source)
  }

  """
  Capture every demo page at mobile, tablet, and desktop resolutions.
  """
  screenshots: Directory! {
    self
      .playwright(self.testService)
      .withExec(["node", "screenshots.mjs"])
      .directory("build/screenshots")
  }

  let testService: Service! {
    Dagger
      .container
      .from("debian:trixie-slim")
      .withWorkdir("/opt/demo")
      .withDirectory(".", self.build)
      .withEnvVariable("IP", "0.0.0.0")
      .withEnvVariable("PORT", "8080")
      .withExposedPort(8080)
      .asService(args: ["./server"])
  }

  let playwright(service: Service!): Container! {
    self
      .node
      .withMountedCache(
        "${HOME}/.cache/ms-playwright",
        Dagger.cacheVolume("ms-playwright"),
        expand: true,
      )
      .withExec(["npm", "exec", "--", "playwright", "install", "chromium", "--with-deps"])
      .withServiceBinding("demo", service)
      .withEnvVariable("PLAYWRIGHT_BASE_URL", service.endpoint(scheme: "http"))
  }

  """
  Build the Cloudflare Worker bundle.
  """
  workerBundle: Directory! @check {
    let client = self
      .dioxus
      .bundle(
        fullstack: false,
        release: true,
        debugSymbols: false,
        platform: DioxusPlatform.WEB,
      )

    let server = self
      .workerBuild
      .build(args: ["--no-default-features", "--features", "worker"])

    Dagger
      .directory
      .withDirectory("dist", client)
      .withDirectory("dist/worker", server)
  }

  """
  Cloudflare Worker bundle as a container.

  This is a workaround until module wiring supports Directory.
  """
  workerBundleAsContainer: Container! {
    Dagger.container.withDirectory("", self.workerBundle)
  }
}
